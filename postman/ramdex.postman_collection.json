{
  "info": {
    "name": "RAMdex API",
    "description": "Motor de busca em memória (índice invertido), a aplicação memory-bound.\n\nAjuste a variável `baseUrl` para o endereço da VM (ex.: http://192.168.56.10:8080). As requisições foram pensadas para rodar em ordem (Run collection): os documentos criados salvam `docId` e o gerador salva `frequentTerm` / `rareTerm` para as buscas seguintes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "docId",
      "value": "1"
    },
    {
      "key": "frequentTerm",
      "value": "baba"
    },
    {
      "key": "rareTerm",
      "value": "dacica"
    }
  ],
  "item": [
    {
      "name": "1. Saúde e métricas",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Stats (índice, heap, GC, sistema)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "stats"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"tem métricas de heap\", () => pm.expect(pm.response.json().memory.heap).to.have.property(\"usedMb\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Documentos",
      "item": [
        {
          "name": "Criar (texto puro)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/plain"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/documents?title=Nota sobre memória",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents"
              ],
              "query": [
                {
                  "key": "title",
                  "value": "Nota sobre memória"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "A memória RAM é o recurso mais disputado por um índice invertido: cada termo guarda a lista de documentos em que aparece."
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"docId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar (JSON)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/documents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Aplicações memory-bound\",\n  \"content\": \"Uma aplicação memory-bound tem o desempenho limitado pela quantidade de memória disponível, e não pela CPU.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"docId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar (upload .md via form-data)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "postman/exemplos/provisionamento.md"
                },
                {
                  "key": "title",
                  "type": "text",
                  "value": "Provisionamento (Markdown)"
                }
              ]
            },
            "description": "Na aba Body → form-data, selecione o arquivo no campo `file` (há exemplos em postman/exemplos). O campo `title` é opcional; sem ele o título é o nome do arquivo."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"docId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar (upload .txt via binary)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/plain"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/documents?title=Índice invertido (txt)",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents"
              ],
              "query": [
                {
                  "key": "title",
                  "value": "Índice invertido (txt)"
                }
              ]
            },
            "body": {
              "mode": "file",
              "file": {
                "src": "postman/exemplos/indice-invertido.txt"
              }
            },
            "description": "Na aba Body → binary, selecione um arquivo .txt ou .md. O título vai no parâmetro `title`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"docId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar (paginado)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents?offset=0&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents"
              ],
              "query": [
                {
                  "key": "offset",
                  "value": "0"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Obter por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents/{{docId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents",
                "{{docId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"traz o conteúdo\", () => pm.expect(pm.response.json().content).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Busca",
      "item": [
        {
          "name": "Buscar (AND: todos os termos)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/search?q=índice memória&mode=and&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "índice memória"
                },
                {
                  "key": "mode",
                  "value": "and"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"encontrou\", () => pm.expect(pm.response.json().total).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar (OR: qualquer termo)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/search?q=swap desempenho cpu&mode=or",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "swap desempenho cpu"
                },
                {
                  "key": "mode",
                  "value": "or"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar sem resultados",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/search?q=kubernetes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "kubernetes"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"vazio\", () => pm.expect(pm.response.json().total).to.eql(0));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Gerador sintético",
      "item": [
        {
          "name": "Gerar 10 mil documentos",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/generate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "generate"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"docs\": 10000,\n  \"wordsPerDoc\": 200,\n  \"vocabSize\": 50000,\n  \"seed\": 42\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Todos os campos são opcionais. Cada 1.000 documentos de 200 palavras ocupam ~12 MB de heap; ajuste `docs` conforme o -Xmx da JVM. A mesma `seed` gera sempre o mesmo conteúdo."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const terms = pm.response.json().sampleTerms;",
                  "pm.collectionVariables.set(\"frequentTerm\", terms.frequent[0]);",
                  "pm.collectionVariables.set(\"rareTerm\", terms.rare[0]);"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar termo frequente",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/search?q={{frequentTerm}}&limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "{{frequentTerm}}"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar termo raro",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/search?q={{rareTerm}}&limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "search"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "{{rareTerm}}"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Stats após gerar",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "stats"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Erros esperados",
      "item": [
        {
          "name": "404: documento inexistente",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents/999999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents",
                "999999999"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "400: busca sem q",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "search"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "400: JSON inválido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/documents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"title\": "
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "415: Content-Type não suportado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/pdf"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/documents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "%PDF-1.4"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 415\", () => pm.response.to.have.status(415));"
                ]
              }
            }
          ]
        },
        {
          "name": "405: método não permitido",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "search"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 405\", () => pm.response.to.have.status(405));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Limpeza",
      "item": [
        {
          "name": "Remover documento",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/documents/{{docId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "documents",
                "{{docId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Limpar índice (com GC)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/index?gc=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "index"
              ],
              "query": [
                {
                  "key": "gc",
                  "value": "true"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
